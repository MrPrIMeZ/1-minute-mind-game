<resources>
    <style name="Theme.Mind" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_bg</item>
    </style>

    <!-- Splash screen shown while the app starts. -->
    <style name="Theme.Mind.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mind</item>
    </style>
</resources>
